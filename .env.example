# ── API ──────────────────────────────────────────────────────────────────────
# Gốc URL API kèm prefix. Local: BE hoặc mock chạy ở cổng 8017.
NEXT_PUBLIC_API_URL=http://localhost:8017/api

# Deploy tách domain (Vercel + Render): để NEXT_PUBLIC_API_URL=/api và đặt origin
# của BE ở đây để Next rewrite /api và /uploads sang BE (cookie cùng origin).
# BACKEND_URL=https://<ten-service>.onrender.com

# ── Socket.IO (thông báo realtime) ───────────────────────────────────────────
# Origin của BE cho websocket; để trống thì suy từ NEXT_PUBLIC_API_URL.
# Bắt buộc đặt khi API đi qua rewrite (Vercel không proxy websocket).
# NEXT_PUBLIC_SOCKET_URL=https://<ten-service>.onrender.com
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
# Polling dự phòng cho số thông báo chưa đọc (ms), 0 = tắt.
# NEXT_PUBLIC_NOTIFICATION_POLL_MS=0

# ── Đăng nhập bằng Google ────────────────────────────────────────────────────
# OAuth 2.0 Client ID loại "Web application" (Google Cloud Console > APIs & Services
# > Credentials), trùng GOOGLE_CLIENT_ID của BE; thêm origin FE (http://localhost:3000,
# domain Vercel) vào "Authorized JavaScript origins". Để trống thì ẩn nút Google.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
